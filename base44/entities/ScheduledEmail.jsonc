{
  "name": "ScheduledEmail",
  "properties": {
    "attempts": {
      "default": 0,
      "description": "Number of failed send attempts so far",
      "type": "number"
    },
    "emailNumber": {
      "description": "Email number in the sequence (1, 2, 3, 4)",
      "type": "number"
    },
    "errorMessage": {
      "description": "Error message if sending failed",
      "type": "string"
    },
    "firstName": {
      "description": "Recipient first name",
      "type": "string"
    },
    "htmlBody": {
      "description": "Full HTML body of the email",
      "type": "string"
    },
    "primaryResult": {
      "description": "Primary result of the quiz submission",
      "type": "string"
    },
    "scheduledAt": {
      "description": "ISO timestamp when this email should be sent",
      "type": "string"
    },
    "secondaryResult": {
      "description": "Secondary result of the quiz submission",
      "type": "string"
    },
    "sentAt": {
      "description": "ISO timestamp when this email was actually sent",
      "type": "string"
    },
    "sequence": {
      "description": "Which nurture sequence this belongs to (e.g. clarity_sprint)",
      "type": "string"
    },
    "status": {
      "default": "scheduled",
      "description": "Current status of the scheduled email. skipped = too overdue to send",
      "enum": [
        "scheduled",
        "sent",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "subject": {
      "description": "Email subject line",
      "type": "string"
    },
    "submissionId": {
      "description": "ID of the QuizSubmission this email belongs to",
      "type": "string"
    },
    "toEmail": {
      "description": "Recipient email address",
      "type": "string"
    }
  },
  "required": [
    "submissionId",
    "toEmail",
    "firstName",
    "sequence",
    "emailNumber",
    "subject",
    "htmlBody",
    "scheduledAt",
    "status"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}